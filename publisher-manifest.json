lor:#33464f;font-size:.95rem;position:relative;z-index:1;max-width:46em}\n.steps li .ghost{position:absolute;right:.5rem;bottom:-1.7rem;font-size:5.4rem;font-weight:800;line-height:1;color:rgba(11,43,63,.07);letter-spacing:-.04em;pointer-events:none}\n\n.plans-wrap{background:var(--paper-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}\n.plans{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.2rem;align-items:start}\n.plan{position:relative;background:#fff;border:1px solid var(--line);padding:1.7rem 1.5rem 1.5rem;display:flex;flex-direction:column;min-height:100%;overflow:hidden}\n.plan.step-1{margin-top:2.4rem}\n.plan.step-2{background:var(--deep);color:var(--paper);border-color:var(--deep);box-shadow:0 14px 30px -20px rgba(11,43,63,.9)}\n.plan.step-3{margin-top:4.8rem}\n.plan .tag{font-size:.7rem;letter-spacing:.2em;color:var(--muted);margin-bottom:.7rem}\n.plan.step-2 .tag{color:var(--amber)}\n.plan h3{font-size:1.3rem;margin-bottom:.3rem}\n.plan .price{font-size:2rem;font-weight:800;letter-spacing:-.02em;color:var(--deep);line-height:1.2}\n.plan.step-2 .price{color:var(--amber-soft)}\n.plan .per{font-size:.82rem;font-weight:400;color:var(--muted);margin-left:.2rem}\n.plan.step-2 .per{color:rgba(247,243,234,.65)}\n.plan .annual{font-size:.86rem;color:var(--amber);margin:.3rem 0 1.2rem;font-weight:600}\n.plan.step-2 .annual{color:var(--amber-soft)}\n.plan ul{margin-bottom:1.4rem;flex:1}\n.plan li{font-size:.92rem;padding:.5rem 0 .5rem 1.2rem;position:relative;border-top:1px dashed rgba(11,43,63,.14);color:#2c3f49}\n.plan li:first-child{border-top:0}\n.plan li::before{content:\"\";position:absolute;left:0;top:1rem;width:.42rem;height:.42rem;background:var(--amber)}\n.plan.step-2 li{color:rgba(247,243,234,.9);border-top-color:rgba(247,243,234,.18)}\n.plan .foot{font-size:.78rem;color:var(--muted);border-top:1px solid var(--line);padding-top:.9rem}\n.plan.step-2 .foot{color:rgba(247,243,234,.6);border-top-color:rgba(247,243,234,.2)}\n.plan .ghost{position:absolute;right:.4rem;top:-.9rem;font-size:5.2rem;font-weight:800;line-height:1;color:rgba(11,43,63,.06);pointer-events:none}\n.plan.step-2 .ghost{color:rgba(247,243,234,.1)}\n\n.client-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}\n.client{position:relative;background:#fff;border:1px solid var(--line);border-left:4px solid var(--amber);padding:1.4rem 1.5rem 1.6rem;overflow:hidden}\n.client h3{font-size:1.02rem;color:var(--deep);margin-bottom:.45rem;position:relative;z-index:1}\n.client p{margin:0;font-size:.92rem;color:#354a55;position:relative;z-index:1}\n.client .meta{display:block;margin-top:.7rem;font-size:.78rem;letter-spacing:.08em;color:var(--muted);position:relative;z-index:1}\n.client .ghost{position:absolute;right:.4rem;bottom:-1.5rem;font-size:4.4rem;font-weight:800;line-height:1;color:rgba(11,43,63,.06);pointer-events:none}\n\n.faq-group{margin-bottom:2.6rem}\n.faq-group > h3{font-size:.8rem;letter-spacing:.2em;color:var(--amber);text-transform:uppercase;margin-bottom:1rem;padding-bottom:.5rem;border-bottom:2px solid var(--deep);color:var(--deep)}\n.faq-item{border-bottom:1px solid var(--line);padding:1.1rem 0}\n.faq-item .q{font-weight:700;color:var(--deep);font-size:1rem;margin:0 0 .4rem}\n.faq-item .a{margin:0;font-size:.94rem;color:#354a55;max-width:48em}\n.faq-item .a strong{color:var(--deep);font-weight:600}\n\n.closing{background:var(--deep);color:var(--paper);padding:3.4rem 0}\n.closing .grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:2.4rem;align-items:center}\n.closing h2{font-size:clamp(1.3rem,2.6vw,1.7rem);margin-bottom:.8rem}\n.closing p{color:rgba(247,243,234,.78);margin:0;font-size:.95rem;max-width:34em}\n.closing .links{display:flex;flex-wrap:wrap;gap:.7rem}\n.closing .links a{color:var(--paper);border:1px solid rgba(247,243,234,.35);padding:.5rem 1.1rem;font-size:.88rem;border-bottom:1px solid rgba(247,243,234,.35)}\n.closing .links a:hover{border-color:var(--amber);color:var(--amber-soft)}\n\nfooter{background:#08222f;color:rgba(247,243,234,.55);font-size:.82rem;padding:1.6rem 0 2rem}\nfooter .inner{max-width:1120px;margin:0 auto;padding:0 1.4rem;display:flex;flex-wrap:wrap;justify-content:space-between;gap:.6rem 1.6rem}\nfooter strong{color:var(--amber-soft);letter-spacing:.14em;font-weight:700}\n\n@media (max-width:900px){\n  .hero .grid{grid-template-columns:1fr;gap:2.2rem}\n  .plans{grid-template-columns:1fr}\n  .plan.step-1,.plan.step-2,.plan.step-3{margin-top:0}\n  .client-list{grid-template-columns:1fr}\n  .closing .grid{grid-template-columns:1fr}\n  .section-head{grid-template-columns:1fr}\n  .section-head p{grid-column:1}\n}\n@media (max-width:520px){\n  body{font-size:15px}\n  .hero{padding:2.8rem 0 3rem}\n  section{padding:2.8rem 0}\n  .topbar .inner,.toc .inner,.wrap,footer .inner{padding-left:1.1rem;padding-right:1.1rem}\n  .steps li .ghost{font-size:4rem;bottom:-1.2rem}\n  .plan .ghost{font-size:4rem}\n}\n</style><div class=\"topbar\">\n  <div class=\"inner\">\n    <span class=\"brandmark\">BICHON</span>\n    <span class=\"crumb\">首页 <span>/</span> 订阅说明</span>\n  </div>\n</div>\n\n<nav class=\"toc\" aria-label=\"页面目录\">\n  <div class=\"inner\">\n    <span class=\"label\">目录</span>\n    <a href=\"#howto\">怎么用</a>\n    <a href=\"#plans\">方案对照</a>\n    <a href=\"#clients\">客户端</a>\n    <a href=\"#faq\">常见问题</a>\n    <a href=\"#contact\">继续了解</a>\n  </div>\n</nav>\n\n<main>\n\n  <header class=\"hero\">\n    <div class=\"wrap\">\n      <div class=\"grid\">\n        <div>\n          <p class=\"kicker\">BICHON · 订阅说明页</p>\n          <h1>Bichon 的订阅怎么选？<br>先把三档的差别<em>看清楚</em>。</h1>\n          <p class=\"lede\">你可能已经看过价格，但还没想好哪一档适合自己。这个页面把 <strong>流量、设备数、线路区分、支持方式</strong> 一次列全，你可以从头读到尾，也可以直接跳到方案表对照。</p>\n          <div class=\"quick\">\n            <span>三档方案：基础版 / 旗舰版 / 团队版</span>\n            <span>均提供月付与年付两种结算</span>\n            <span>页内 FAQ 按主题分组</span>\n          </div>\n        </div>\n        <aside class=\"panel\" aria-label=\"方案速览\">\n          <h2>一眼看清</h2>\n          <dl>\n            <div class=\"row\">\n              <dt>起步档</dt>\n              <dd>基础版 ¥15/月</dd>\n            </div>\n            <div class=\"row\">\n              <dt>常用档</dt>\n              <dd>旗舰版 ¥35/月</dd>\n            </div>\n            <div class=\"row\">\n              <dt>多设备档</dt>\n              <dd>团队版 ¥85/月</dd>\n            </div>\n            <div class=\"row\">\n              <dt>年付方式</dt>\n              <dd>按 10 个月计</dd>\n            </div>\n            <div class=\"row\">\n              <dt>设备上限</dt>\n              <dd>3 / 5 / 20 台</dd>\n            </div>\n          </dl>\n          <p class=\"note\">以上为页面所列方案信息，不构成实时价格承诺；下单前请以你看到的结算页面为准。</p>\n        </aside>\n      </div>\n    </div>\n  </header>\n\n  <section id=\"howto\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <span class=\"num\">01</span>\n        <h2>从没接触过，应该按什么顺序来？</h2>\n        <p>不用一口气读完。按下面四步走，每一步都对应一个你真正要做的决定。</p>\n      </div>\n      <ol class=\"steps\">\n        <li>\n          <span class=\"ghost\">01</span>\n          <h3>先确认自己要连几台设备</h3>\n          <p>设备数是三档方案最硬的差别：3 台、5 台、20 台。先把手机、平板、电脑加起来数一遍，再回头看价格，往往能省掉一轮纠结。</p>\n        </li>\n        <li>\n          <span class=\"ghost\">02</span>\n          <h3>再估一下每月的用量</h3>\n          <p>100GB、300GB、1000GB 是三档的流量档位。日常浏览、收发消息和看标清视频，与长时间看高清视频，用量差距会很明显。估不准就先从低档起步。</p>\n        </li>\n        <li>\n          <span class=\"ghost\">03</span>\n          <h3>然后看线路与支持的差别</h3>\n          <p>基础版为普通线路节点池；旗舰版标注全节点原生流媒体解锁与 IPLC 专线游戏加速优化，并附 7x24 优先工单支持；团队版另加 VIP 专属高带宽节点、企业定制路由与专属客户经理。</p>\n        </li>\n        <li>\n          <span class=\"ghost\">04</span>\n          <h3>最后决定月付还是年付</h3>\n          <p>年付按 10 个月计费，比按月续 12 次少两个月。如果你只是想先试试，月付更灵活；如果确定长期使用，年付更省。</p>\n        </li>\n      </ol>\n    </div>\n  </section>\n\n  <div class=\"plans-wrap\" id=\"plans\">\n    <section>\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <span class=\"num\">02</span>\n          <h2>三档方案，阶梯式递进</h2>\n          <p>从左到右，流量、设备数、线路与支持逐级递进。价格是页面标注价格，年付按 10 个月计。</p>\n        </div>\n        <div class=\"plans\">\n\n          <article class=\"plan step-1\">\n            <span class=\"ghost\">01</span>\n            <p class=\"tag\">LEVEL 01</p>\n            <h3>基础版</h3>\n            <p class=\"price\">¥15<span class=\"per\">/月</span></p>\n            <p class=\"annual\">按年付 ¥150/年</p>\n            <ul>\n              <li>每月 100GB 流量</li>\n              <li>3 台设备同时在线</li>\n              <li>解锁基础流媒体</li>\n              <li>普通线路节点池</li>\n            </ul>\n            <p class=\"foot\">适合设备少、用量稳定、以日常浏览为主的使用者。</p>\n          </article>\n\n          <article class=\"plan step-2\">\n            <span class=\"ghost\">02</span>\n            <p class=\"tag\">LEVEL 02 · 多数人的选择</p>\n            <h3>旗舰版</h3>\n            <p class=\"price\">¥35<span class=\"per\">/月</span></p>\n            <p class=\"annual\">按年付 ¥350/年</p>\n            <ul>\n              <li>每月 300GB 流量</li>\n              <li>5 台设备同时在线</li>\n              <li>全节点原生流媒体解锁</li>\n              <li>IPLC 专线游戏加速优化</li>\n              <li>7x24 优先工单支持</li>\n            </ul>\n            <p class=\"foot\">适合多设备、看重流媒体解锁与游戏线路的使用者。</p>\n          </article>\n\n          <article class=\"plan step-3\">\n            <span class=\"ghost\">03</span>\n            <p class=\"tag\">LEVEL 03</p>\n            <h3>团队版</h3>\n            <p class=\"price\">¥85<span class=\"per\">/月</span></p>\n            <p class=\"annual\">按年付 ¥850/年</p>\n            <ul>\n              <li>每月 1000GB 流量</li>\n              <li>20 台设备同时在线</li>\n              <li>VIP 专属高带宽节点</li>\n              <li>支持企业定制路由</li>\n              <li>专属客户经理服务</li>\n            </ul>\n            <p class=\"foot\">适合多人共用、需要统一路由规划的小团队。</p>\n          </article>\n\n        </div>\n      </div>\n    </section>\n  </div>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <span class=\"num\">03</span>\n        <h2>客户端：先在熟悉的设备上跑通</h2>\n        <p>下面是常见的接入环境分类，按你自己的设备对号入座即可。具体安装包与配置以获得方式为准，本页不提供下载链接。</p>\n      </div>\n      <div class=\"client-list\">\n        <article class=\"client\">\n          <span class=\"ghost\">A</span>\n          <h3>桌面端环境</h3>\n          <p>Windows 与 macOS 上通常需要系统级代理客户端配合配置使用；多设备方案可在同一台电脑上先验证线路是否正常，再切换到其他设备。</p>\n          <span class=\"meta\">适用：基础版 / 旗舰版 / 团队版</span>\n        </article>\n        <article class=\"client\">\n          <span class=\"ghost\">B</span>\n          <h3>移动端环境</h3>\n          <p>iOS 与 Android 一般通过对应平台的客户端完成配置。注意移动端常与桌面端共用设备名额，购买前把两台设备的数量一起算进去。</p>\n          <span class=\"meta\">适用：基础版 / 旗舰版 / 团队版</span>\n        </article>\n        <article class=\"client\">\n          <span class=\"ghost\">C</span>\n          <h3>路由器与家庭网络</h3>\n          <p>如果希望家里所有设备共用一条线路，可在支持的路由器上做统一接入。这种方式更依赖设备名额与线路稳定性，建议优先考虑旗舰版或以上。</p>\n          <span class=\"meta\">建议：旗舰版 / 团队版</span>\n        </article>\n        <article class=\"client\">\n          <span class=\"ghost\">D</span>\n          <h3>团队统一配置</h3>\n          <p>团队版提供企业定制路由与专属客户经理支持，适合需要统一规划接入方式、再分发给成员的环境。</p>\n          <span class=\"meta\">建议：团队版</span>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <span class=\"num\">04</span>\n        <h2>常见问题，按主题分组</h2>\n        <p>如果你只关心其中一类，直接看你所在的那组即可，不必逐条读完。</p>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>关于方案与价格</h3>\n        <div class=\"faq-item\">\n          <p class=\"q\">三档方案最主要的区别是什么？</p>\n          <p class=\"a\">看三个数字就够了：<strong>流量 100GB / 300GB / 1000GB</strong>，<strong>设备 3 / 5 / 20 台</strong>，以及线路与支持的层级。基础版是普通线路节点池；旗舰版增加全节点原生流媒体解锁、IPLC 专线游戏加速优化与 7x24 优先工单支持；团队版再增加 VIP 专属高带宽节点、企业定制路由与专属客户经理。</p>\n        </div>\n        <div class=\"faq-item\">\n          <p class=\"q\">年付能省多少？</p>\n          <p class=\"a\">年付按 10 个月计：基础版 ¥150/年、旗舰版 ¥350/年、团队版 ¥850/年，相当于比按月支付 12 次少两个月。</p>\n        </div>\n        <div class=\"faq-item\">\n          <p class=\"q\">可以中途换档吗？</p>\n          <p class=\"a\">本页只列出方案本身的差异，不包含换档规则。实际是否支持升级、补差价或降级，请以你下单时看到的说明为准，避免按本页内容推断。</p>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>关于用量与设备</h3>\n        <div class=\"faq-item\">\n          <p class=\"q\">我该怎么判断自己需要多少流量？</p>\n          <p class=\"a\">先回想最近一个月的使用习惯：如果主要是网页、文档和通讯，100GB 档通常够起步；如果有较多视频播放，300GB 档更稳妥；如果多人共用或长时间高负载，再考虑 1000GB 档。估不准时，从低档开始比从高档开始更容易调整。</p>\n        </div>\n        <div class=\"faq-item\">\n          <p class=\"q\">\"同时在线\"是什么意思？</p>\n          <p class=\"a\">指同一时间保持连接的设备数量上限。手机、平板、电脑、路由器都算在内。基础版 3 台、旗舰版 5 台、团队版 20 台，建议在购买前把手上的设备数一遍。</p>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>关于使用与支持</h3>\n        <div class=\"faq-item\">\n          <p class=\"q\">第一次使用，应该先做哪一步？</p>\n          <p class=\"a\">先在一台设备上完成配置并确认线路可用，再逐步增加其他设备。这样一旦出现问题，你能快速判断是单台设备的问题还是线路本身的问题。</p>\n        </div>\n        <div class=\"faq-item\">\n          <p class=\"q\">遇到问题，不同方案的支持方式一样吗？</p>\n          <p class=\"a\">不一样。旗舰版提供 7x24 优先工单支持，团队版另外提供专属客户经理服务；基础版未在方案中列出优先支持项。具体响应方式以实际支持渠道的说明为准。</p>\n        </div>\n        <div class=\"faq-item\">\n          <p class=\"q\">本页会提供下载地址吗？</p>\n          <p class=\"a\">不会。本页只负责把方案与使用思路讲清楚，不提供安装包或配置文件的下载链接，也不受理交易。客户端获取方式请以你手上的正式说明为准。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"closing\" id=\"contact\">\n    <div class=\"wrap\">\n      <div class=\"grid\">\n        <div>\n          <h2>还想再看一遍对照？</h2>\n          <p>方案表、使用步骤与 FAQ 都在本页。建议先确定设备数，再对照流量档位，最后决定月付还是年付——这个顺序能帮你少走弯路。</p>\n        </div>\n        <div class=\"links\">\n          <a href=\"#plans\">回到方案对照</a>\n          <a href=\"#howto\">再看使用步骤</a>\n          <a href=\"#faq\">重读常见问题</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"inner\">\n    <span><strong>BICHON</strong> · 订阅说明页</span>\n    <span>本页信息以页面所列内容为准，不构成实时价格或服务承诺。</span>\n  </div>\n</footer>",
